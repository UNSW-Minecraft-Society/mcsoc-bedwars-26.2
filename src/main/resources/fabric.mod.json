{
	"schemaVersion": 1,
	"id": "bedwars-plugin",
	"version": "${version}",
	"name": "MCSoc's Bedwars",
	"description": "Bedwars recreation for UNSW MCSoc's 2026 Games Galore component.",
	"authors": [
		"veveddo",
        "Synkct",
        "QuackQuackAlice",
        "Titanplayz",
        "Gabz"
	],
	"contact": {
		"homepage": "https://unswminecraft.com",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/bedwars-plugin/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "mcsoc.bedwars.BedwarsPlugin",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "mcsoc.bedwars.client.BedwarsPluginDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"bedwars-plugin.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
